178	        Parameters
179	        ----------
180	        x : torch.Tensor, shape (batch, context_len, n_features)
181	            Past observations.
182	
183	        Returns
184	        -------
185	        torch.Tensor, shape (batch, pred_len, n_features)
186	            Forecasted values.
187	        """
188	        batch_size = x.size(0)
189	        h_0 = self.h_0.expand(
190	            self.num_layers * 2, batch_size, self.rnn_dim
191	        ).contiguous()
192	        rnn_output, _ = self.rnn(x, h_0)
193	
194	        z_prev = self.z_q_0.expand(batch_size, self.z_dim)
195	        for t in range(1, x.size(1) + 1):
196	            z_loc, _ = self.combiner(z_prev, rnn_output[:, t - 1, :])
197	            z_t = z_loc
198	            z_prev = z_t
199	
200	        preds = []
201	        x_t = x[:, -1, :]
202	
203	        for _ in range(self.pred_len):
204	            mu, _ = self.emitter(z_t, x_t)
205	            preds.append(mu)
206	            z_loc, _ = self.transition(z_t, x_t)
207	            z_t = z_loc
208	            x_t = mu
209	
210	        return torch.stack(preds, dim=1)
211	
212	
213	class DMMForecaster(EncoderDecoderForecaster):
214	    """Deep Markov Model encoder-decoder forecaster.
215	
216	    Parameters
217	    ----------
218	    z_dim : int, default=32
219	        Dimensionality of latent states.
220	    emission_dim : int, default=32
221	        Dimensionality of emission parameters.
222	    transition_dim : int, default=32
223	        Dimensionality of transition parameters.
224	    rnn_dim : int, default=32
225	        Dimensionality of RNN hidden states.
226	    num_layers : int, default=1
227	        Number of RNN layers.
228	    dropout : float, default=0.2
229	        Dropout rate.
230	    variance : float, default=0.1
231	        Variance for distributions.
232	    activation : str, default='relu'
233	        Activation function.
234	    bias : bool, default=True
235	        Use bias terms.
236	    context_len : int, default=20
237	        Encoder window length.
238	    pred_len : int, default=1
239	        Decoder window length.
240	    **kwargs
241	        Passed to EncoderDecoderForecaster.
242	    """
243	
244	    def __init__(
245	        self,
246	        z_dim=32,
247	        emission_dim=32,
248	        transition_dim=32,
249	        rnn_dim=32,
250	        num_layers=1,
251	        dropout=0.2,
252	        variance=0.1,
253	        activation="relu",
254	        bias=True,
255	        context_len=20,
256	        pred_len=1,
257	        **kwargs,
258	    ):
259	        self.z_dim = z_dim
260	        self.emission_dim = emission_dim
261	        self.transition_dim = transition_dim
262	        self.rnn_dim = rnn_dim
263	        self.num_layers = num_layers
264	        self.dropout = dropout
265	        self.variance = variance
266	        self.activation = activation
267	        self.bias = bias
268	
269	        super().__init__(
270	            context_len=context_len,
271	            pred_len=pred_len,
272	            **kwargs,
273	        )
274	        self.prob = True
275	        self._modules = ["module"]
276	
277	    def __sklearn_tags__(self):
278	        from sklearn.utils._tags import InputTags, Tags, TargetTags
279	
280	        return Tags(
281	            estimator_type="regressor",
282	            target_tags=TargetTags(required=True, multi_output=True),
283	            input_tags=InputTags(two_d_array=True),
284	        )
285	
286	    def _get_tags(self):
287	        return {"requires_y": True}
288	
289	    def initialize_module(self):
290	        """Create the DMM encoder-decoder module."""
291	        self.module_ = DMMModel(
292	            n_features=self.n_features_in_,
293	            pred_len=self.pred_len,
294	            z_dim=self.z_dim,
295	            emission_dim=self.emission_dim,
296	            transition_dim=self.transition_dim,
297	            rnn_dim=self.rnn_dim,
298	            num_layers=self.num_layers,
299	            dropout=self.dropout,
300	            variance=self.variance,
301	            activation=self.activation,
302	            bias=self.bias,
303	            context_len=self.context_len,
304	        )
305	        self.module_.initialize_module(self.n_features_in_)
306	        return self
307	
308	    def initialize_optimizer(self, triggered_directly=None):
309	        """Override to create a Pyro optimizer for SVI."""
310	        from pyro.optim import Adam
311	
312	        optim_args = {"lr": getattr(self, "lr", 0.01)}
313	        self.optimizer_ = Adam(optim_args)
314	        return self
315	
316	    def model(self, x, y, annealing_factor=1.0):
317	        """Generative model for SVI."""
318	        return self.module_.model(x, y, annealing_factor)
319	
320	    def guide(self, x, y=None, annealing_factor=1.0):
321	        """Variational guide for SVI."""
322	        return self.module_.guide(x, y, annealing_factor)
323	
324	    def forward(self, x, y=None):
325	        """Forward pass through the DMM model.
326	
327	        Parameters
328	        ----------
329	        x : torch.Tensor
330	            Input context window.
331	        y : torch.Tensor or None
332	            Unused; kept for API compatibility.
333	
334	        Returns
335	        -------
336	        torch.Tensor
337	            Predictions of shape (batch, pred_len, n_features).
338	        """
339	        return self.module_.forward(x)
340	
341	    def _set_training(self, training=True):
342	        """Override to set training mode on the underlying Pyro module."""
343	        self.module_.train(training)
344	
345	    def train_step_single(self, batch, **fit_params):
346	        """Override to pass targets to ``infer`` for y_pred logging."""
347	        self._set_training(True)
348	        Xi, yi = unpack_data(batch)
349	        if not self.prob:
350	            y_pred = self.infer(Xi, y=yi, **fit_params)
351	            loss = self.get_loss(y_pred, yi, X=Xi, training=True)
352	            loss.backward()
353	            return {"loss": loss, "y_pred": y_pred}
354	        return super().train_step_single(batch, **fit_params)
355	
356	    def state_dict(self):
357	        """Return the state dict of the underlying Pyro module."""
358	        return self.module_.state_dict()
359	
360	    def load_state_dict(self, state_dict, strict=True):
361	        """Load a state dict into the underlying Pyro module."""
362	        self.module_.load_state_dict(state_dict, strict=strict)
363	
364	    @property
365	    def model_type(self):
366	        return "rnn"
367	
