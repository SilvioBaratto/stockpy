137	                    dist.Normal(mu, sigma).to_event(1),
138	                    obs=full_seq[:, t - 1, :],
139	                )
140	                z_prev = z_t
141	
142	    def guide(self, x, y=None, annealing_factor=1.0):
143	        """Variational guide (inference network).
144	
145	        Parameters
146	        ----------
147	        x : torch.Tensor, shape (batch, context_len, n_features)
148	            Past observations.
149	        y : torch.Tensor or None, shape (batch, pred_len, n_features)
150	            Future observations. If None, only context is processed.
151	        annealing_factor : float, default=1.0
152	            KL-divergence annealing factor.
153	        """
154	        full_seq = torch.cat([x, y], dim=1) if y is not None else x
155	        T = full_seq.size(1)
156	
157	        pyro.module("dmm", self)
158	        h_0 = self.h_0.expand(
