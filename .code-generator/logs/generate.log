52	class TimeSeriesDataset(StockpyDataset):
53	    """
54	    A dataset class for time-series forecasting with context and prediction windows.
55	
56	    This class produces sliding windows over a multivariate time series,
57	    returning past-context and future-target pairs suitable for
58	    encoder-decoder forecasters.
59	
60	    Parameters
61	    ----------
62	    X : array-like, shape (n_samples, n_features)
63	        The input time series data.
64	    y : array-like, shape (n_samples, n_targets) or None, optional
65	        The target time series data. If ``None``, the target is derived
66	        from ``X`` itself (auto-regressive forecasting).
67	    length : int, optional
68	        The total number of samples. Inferred from ``X`` if not given.
69	    context_len : int, default=20
70	        Number of past time steps to use as model input.
71	    pred_len : int, default=1
72	        Number of future time steps to predict.
73	    stride : int, default=1
74	        Step size between consecutive windows.
75	
76	    Attributes
77	    ----------
78	    context_len : int
79	        Length of the context window.
80	    pred_len : int
81	        Length of the prediction window.
82	    stride : int
83	        Stride between consecutive windows.
84	
85	    Examples
86	    --------
87	    >>> import numpy as np
88	    >>> X = np.arange(24).reshape(12, 2).astype(np.float32)
89	    >>> ds = TimeSeriesDataset(X, context_len=4, pred_len=3)
90	    >>> x, y = ds[0]
91	    >>> x.shape
92	    torch.Size([4, 2])
93	    >>> y.shape
94	    torch.Size([3, 2])
95	    """
96	
97	    def __init__(
98	        self,
99	        X,
100	        y=None,
101	        length=None,
102	        context_len=20,
103	        pred_len=1,
104	        stride=1,
105	    ):
106	        super().__init__(X, y, length=length)
107	
108	        if hasattr(self.X, "shape") and len(self.X.shape) != 2:
109	            raise ValueError(
110	                "X must be 2-dimensional with shape (time_steps, features). "
111	                f"Got shape with {len(self.X.shape)} dimension(s)."
112	            )
113	
114	        if context_len <= 0:
115	            raise ValueError("context_len must be a positive integer")
116	        if pred_len <= 0:
117	            raise ValueError("pred_len must be a positive integer")
118	        if stride <= 0:
119	            raise ValueError("stride must be a positive integer")
120	
121	        self.context_len = context_len
122	        self.pred_len = pred_len
123	        self.stride = stride
124	
125	        series_len = self._len
126	        min_required = self.context_len + self.pred_len
127	        if series_len < min_required:
128	            raise ValueError(
129	                f"Series length ({series_len}) is too short for "
130	                f"context_len ({context_len}) + pred_len ({pred_len}). "
131	                f"Minimum required: {min_required}."
132	            )
133	
134	        self._len = (series_len - min_required) // self.stride + 1
135	
136	    def __getitem__(self, i):
137	        """
138	        Retrieve the i-th sliding window from the dataset.
139	
140	        Parameters
141	        ----------
142	        i : int
143	            Index of the window.
144	
145	        Returns
146	        -------
147	        tuple
148	            A 2-tuple ``(x_context, y_target)`` where both elements are
149	            ``torch.Tensor``.
150	
151	            * ``x_context`` has shape ``(context_len, n_features)``.
152	            * ``y_target`` has shape ``(pred_len, n_features)`` when
153	              ``y`` is ``None``, or ``(pred_len, n_targets)`` when
154	              ``y`` is provided.
155	        """
156	        if i < 0 or i >= self._len:
157	            raise IndexError(
158	                f"Index {i} is out of bounds for dataset with length {self._len}"
159	            )
160	
161	        start_idx = i * self.stride
162	        context_end = start_idx + self.context_len
163	        target_end = context_end + self.pred_len
164	
165	        Xi = multi_indexing(self.X, slice(start_idx, context_end), self.X_indexing)
166	
167	        if self.y is not None:
168	            yi = multi_indexing(self.y, slice(context_end, target_end), self.y_indexing)
169	        else:
170	            yi = multi_indexing(self.X, slice(context_end, target_end), self.X_indexing)
171	
172	        Xi, yi = self.transform(Xi, yi)
173	
174	        Xi = torch.as_tensor(Xi, dtype=torch.float32)
175	        yi = torch.as_tensor(yi, dtype=torch.float32)
176	
177	        return Xi, yi
178	
