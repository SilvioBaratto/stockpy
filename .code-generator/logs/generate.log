11	class GRUModel(nn.Module):
12	    """GRU-based encoder-decoder for time-series forecasting.
13	
14	    Parameters
15	    ----------
16	    n_features : int
17	        Number of input/output features.
18	    pred_len : int
19	        Number of future time steps to predict.
20	    rnn_size : int, default=32
21	        Hidden size of GRU layers.
22	    hidden_size : int, default=32
23	        Hidden size of the output projection MLP.
24	    num_layers : int, default=1
25	        Number of stacked GRU layers.
26	    dropout : float, default=0.0
27	        Dropout rate (applied when num_layers > 1).
28	    activation : str, default='relu'
29	        Activation function for the projection MLP.
30	    bias : bool, default=True
31	        Use bias in GRU and linear layers.
32	    """
33	
34	    def __init__(
35	        self,
36	        n_features,
37	        pred_len,
38	        rnn_size=32,
39	        hidden_size=32,
40	        num_layers=1,
41	        dropout=0.0,
42	        activation="relu",
43	        bias=True,
44	    ):
45	        super().__init__()
46	        self.n_features = n_features
47	        self.pred_len = pred_len
48	        self.rnn_size = rnn_size
49	        self.hidden_size = hidden_size
50	        self.num_layers = num_layers
51	        self.dropout = dropout
52	
53	        self.encoder = nn.GRU(
54	            input_size=n_features,
55	            hidden_size=rnn_size,
56	            num_layers=num_layers,
57	            batch_first=True,
58	            bias=bias,
59	            dropout=dropout if num_layers > 1 else 0.0,
60	        )
61	
62	        self.decoder = nn.GRU(
63	            input_size=n_features,
64	            hidden_size=rnn_size,
65	            num_layers=num_layers,
66	            batch_first=True,
67	            bias=bias,
68	            dropout=dropout if num_layers > 1 else 0.0,
69	        )
70	
71	        act = get_activation_function(activation)
72	        self.output_proj = nn.Sequential(
73	            nn.Linear(rnn_size, hidden_size, bias=bias),
74	            act,
75	            nn.Dropout(dropout),
76	            nn.Linear(hidden_size, n_features, bias=bias),
77	        )
78	
79	    def forward(self, x, y=None):
80	        """Forward pass.
81	
82	        Parameters
83	        ----------
84	        x : torch.Tensor, shape (batch, context_len, n_features)
85	            Past context window.
86	        y : torch.Tensor or None, shape (batch, pred_len, n_features)
87	            Ground-truth future values for teacher forcing. If None,
88	            the decoder runs autoregressively.
89	
90	        Returns
91	        -------
92	        torch.Tensor, shape (batch, pred_len, n_features)
93	            Forecasted values.
94	        """
95	        # Encode context window
96	        _, hidden = self.encoder(x)
97	        # hidden: (num_layers, batch, rnn_size)
98	
99	        if y is not None:
100	            # Teacher forcing: use ground-truth shifted by one timestep
101	            # First decoder input is the last timestep of encoder input
102	            first_input = x[:, -1:, :]  # (batch, 1, n_features)
103	            decoder_input = torch.cat([first_input, y[:, :-1, :]], dim=1)
104	            # decoder_input: (batch, pred_len, n_features)
105	            out, _ = self.decoder(decoder_input, hidden)
106	            # out: (batch, pred_len, rnn_size)
107	            return self.output_proj(out)
108	        else:
109	            # Autoregressive decoding
110	            decoder_input = x[:, -1:, :]  # (batch, 1, n_features)
111	            outputs = []
112	            for _ in range(self.pred_len):
113	                out, hidden = self.decoder(decoder_input, hidden)
114	                # out: (batch, 1, rnn_size)
115	                pred = self.output_proj(out)  # (batch, 1, n_features)
116	                outputs.append(pred)
117	                decoder_input = pred  # feed previous prediction as next input
118	            return torch.cat(outputs, dim=1)  # (batch, pred_len, n_features)
119	
120	
121	class GRUForecaster(EncoderDecoderForecaster):
122	    """GRU-based encoder-decoder forecaster.
123	
124	    Parameters
125	    ----------
126	    rnn_size : int, default=32
127	        Number of features in the GRU hidden state.
128	    hidden_size : int, default=32
129	        Size of the fully-connected projection layer.
130	    num_layers : int, default=1
131	        Number of stacked GRU layers.
132	    dropout : float, default=0.2
133	        Dropout rate.
134	    activation : str, default='relu'
135	        Activation function.
136	    bias : bool, default=True
137	        Use bias terms.
138	    context_len : int, default=20
139	        Encoder window length.
140	    pred_len : int, default=1
141	        Decoder window length.
142	    **kwargs
143	        Passed to EncoderDecoderForecaster.
144	    """
145	
146	    def __init__(
147	        self,
148	        rnn_size=32,
149	        hidden_size=32,
150	        num_layers=1,
151	        dropout=0.2,
152	        activation="relu",
153	        bias=True,
154	        context_len=20,
155	        pred_len=1,
156	        **kwargs,
157	    ):
158	        self.rnn_size = rnn_size
159	        self.hidden_size = hidden_size
160	        self.num_layers = num_layers
161	        self.dropout = dropout
162	        self.activation = activation
163	        self.bias = bias
164	
165	        super().__init__(
166	            context_len=context_len,
167	            pred_len=pred_len,
168	            **kwargs,
169	        )
170	        self._modules = ["module"]
171	
172	    def __sklearn_tags__(self):
173	        from sklearn.utils._tags import InputTags, Tags, TargetTags
174	
175	        return Tags(
176	            estimator_type="regressor",
177	            target_tags=TargetTags(required=True, multi_output=True),
178	            input_tags=InputTags(two_d_array=True),
179	        )
180	
181	    def _get_tags(self):
182	        return {"requires_y": True}
183	
184	    def initialize_module(self):
185	        """Create the GRU encoder-decoder module and loss criterion."""
186	        self.module_ = GRUModel(
187	            n_features=self.n_features_in_,
188	            pred_len=self.pred_len,
189	            rnn_size=self.rnn_size,
190	            hidden_size=self.hidden_size,
191	            num_layers=self.num_layers,
192	            dropout=self.dropout,
193	            activation=self.activation,
194	            bias=self.bias,
195	        )
196	        self.criterion_ = nn.MSELoss()
197	        return self
198	
199	    def _set_training(self, training=True):
200	        """Override to set training mode on the PyTorch module."""
201	        self.module_.train(training)
202	
203	    def forward(self, x, y=None):
204	        """Forward pass through the GRU model.
205	
206	        Parameters
207	        ----------
208	        x : torch.Tensor
209	            Input context window.
210	        y : torch.Tensor or None
211	            Target values for teacher forcing.
212	
213	        Returns
214	        -------
215	        torch.Tensor
216	            Predictions of shape (batch, pred_len, n_features).
217	        """
218	        return self.module_(x, y=y)
219	
220	    def train_step_single(self, batch, **fit_params):
221	        """Override to pass targets to ``infer`` for teacher forcing."""
222	        self._set_training(True)
223	        Xi, yi = unpack_data(batch)
224	        if not self.prob:
225	            y_pred = self.infer(Xi, y=yi, **fit_params)
226	            loss = self.get_loss(y_pred, yi, X=Xi, training=True)
227	            loss.backward()
228	            return {"loss": loss, "y_pred": y_pred}
229	        return super().train_step_single(batch, **fit_params)
230	
231	    def state_dict(self):
232	        """Return the state dict of the underlying PyTorch module."""
233	        return self.module_.state_dict()
234	
235	    def load_state_dict(self, state_dict, strict=True):
236	        """Load a state dict into the underlying PyTorch module."""
237	        self.module_.load_state_dict(state_dict, strict=strict)
238	
239	    @property
240	    def model_type(self):
241	        return "rnn"
242	
