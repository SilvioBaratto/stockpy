54	def _extract_optimizer_param_name_and_group(optimizer_name, param):
55	    """
56	    Extract the parameter name and group from a given parameter string based on the optimizer name.
57	
58	    The function uses a regular expression to parse the parameter string, which should follow the
59	    pattern 'optimizer_name__[param_groups__<group_number>__]<parameter_name>'. If the group number
60	    is not specified, it defaults to 'all'.
61	
62	    Parameters
63	    ----------
64	    optimizer_name : str
65	        The name of the optimizer to which the parameter belongs.
66	    param : str
67	        The parameter string to parse.
68	
69	    Returns
70	    -------
71	    tuple
72	        A tuple containing the parameter group (str) and parameter name (str).
73	
74	    Raises
75	    ------
76	    AttributeError
77	        If the parameter string does not match the expected pattern.
78	
79	    Examples
80	    --------
81	    >>> _extract_optimizer_param_name_and_group('adam', 'adam__param_groups__1__lr')
82	    ('1', 'lr')
83	    >>> _extract_optimizer_param_name_and_group('sgd', 'sgd__momentum')
84	    ('all', 'momentum')
85	    """
86	
87	    # Combine both patterns into a single one using a non-capturing group for the optional part.
88	    pattern = rf"{optimizer_name}__(?:param_groups__(?P<group>\d+)__)?(?P<name>.+)"
89	
90	    # Compile the regular expression pattern.
91	    compiled_pattern = re.compile(pattern)
92	
93	    # Match the parameter against the compiled pattern.
94	    match = compiled_pattern.fullmatch(param)
95	
96	    # Raise an exception if there is no match.
97	    if not match:
98	        raise AttributeError(
99	            f'Invalid parameter "{param}" for optimizer "{optimizer_name}"'
100	        )
