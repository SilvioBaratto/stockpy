460	
461	        with torch.no_grad():
462	            out_a = model.forward(x, y=y_a)
463	            out_b = model.forward(x, y=y_b)
464	
465	        # Earlier positions must be unchanged by perturbing the future target.
466	        assert torch.allclose(out_a[:, :-1, :], out_b[:, :-1, :], atol=1e-5)
