9	def unpack_data(data):
10	    """
11	    Unpack data returned by the net's iterator into a 2-tuple.
12	
13	    This function is designed to be used within a loop where data is
14	    being iterated, typically from a DataLoader in PyTorch. It expects
15	    each item of the iteration to be a 2-tuple or a 2-element list, which
16	    it then unpacks into the input data (features) and the target data
17	    (labels). If the data iterable doesn't contain exactly two elements,
18	    it is considered an error and raises an exception.
19	
20	    Parameters
21	    ----------
22	    data : iterable
23	        An iterable that yields elements, which should be pairs (2-tuple or
24	        2-list) of features and labels.
25	
26	    Returns
27	    -------
28	    tuple
29	        A 2-tuple where the first element is the unpacked features and the
30	        second element is the unpacked labels.
31	
32	    Raises
33	    ------
34	    ValueError
35	        If `data` does not contain exactly two elements.
36	
37	    Notes
38	    -----
39	    This function cannot detect it when a user only returns 1
40	    item that is exactly of length 2 (e.g., because the batch size is
41	    2). In that case, the item will be erroneously split into X and y.
42	    """
43	    if len(data) != 2:
44	        raise ValueError(
45	            f"Expected data to be a 2-tuple or 2-list, got {len(data)} elements instead."
46	        )
47	
48	    X, y = data
49	    return X, y
50	
