115	def _set_optimizer_param(optimizer, param_group, param_name, value):
116	    """
117	    Set a specific parameter for an optimizer's parameter group(s).
118	
119	    This function directly modifies the optimizer's parameter groups by setting a specific
120	    parameter (e.g., learning rate) to a new value. If 'all' is passed as the param_group,
121	    the parameter is set for all parameter groups; otherwise, it sets the parameter for
122	    the specified group only.
123	
124	    Parameters
125	    ----------
126	    optimizer : Optimizer
127	        The optimizer object (e.g., instance of torch.optim.Optimizer).
128	    param_group : str or int
129	        The index of the parameter group as an integer, or 'all'
130	        to indicate all parameter groups.
131	    param_name : str
132	        The name of the parameter to be set (e.g., 'lr' for learning rate).
133	    value : float
134	        The new value to set for the parameter.
135	
136	    Examples
137	    --------
138	    >>> optimizer = torch.optim.Adam([...], lr=0.001)  # An example optimizer
139	    >>> _set_optimizer_param(optimizer, 'all', 'lr', 0.01)
140	    # This sets the learning rate to 0.01 for all parameter groups
141	
142	    >>> _set_optimizer_param(optimizer, 0, 'betas', (0.9, 0.999))
143	    # This sets the 'betas' parameter for the first parameter group only
144	
145	    Raises
146	    ------
147	    IndexError
148	        If the `param_group` is not 'all' and does not correspond to a valid index in the optimizer's parameter groups.
149	    KeyError
150	        If the `param_name` is not a valid parameter for the optimizer's parameter groups.
151	    """
152	
153	    # Obtain the appropriate optimizer parameter groups.
154	    groups = (
155	        optimizer.param_groups
156	        if param_group == "all"
157	        else [optimizer.param_groups[int(param_group)]]
158	    )
159	
160	    # Set the parameter value for the chosen groups.
161	    for group in groups:
162	        if param_name not in group:
163	            raise KeyError(
164	                f'Parameter "{param_name}" not found in the optimizer parameter group.'
165	            )
166	        group[param_name] = value
167	
