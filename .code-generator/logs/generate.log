126	        with pyro.plate("z_minibatch", len(x)):
127	            for t in pyro.markov(range(1, T + 1)):
128	                z_loc, z_scale = self.transition(z_prev, full_seq[:, t - 1, :])
129	                with pyro.poutine.scale(scale=annealing_factor):
