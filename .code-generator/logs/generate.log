12	class CausalConv1d(nn.Module):
13	    """Causal 1-D convolution that maintains temporal ordering.
14	
15	    Left-pads the input by ``(kernel_size - 1) * dilation`` so that the
16	    output at time *t* only depends on inputs at times ``<= t``.
17	    """
18	
19	    def __init__(self, in_channels, out_channels, kernel_size, dilation=1, bias=True):
20	        super().__init__()
21	        self.pad = (kernel_size - 1) * dilation
22	        self.conv = nn.Conv1d(
23	            in_channels,
24	            out_channels,
25	            kernel_size,
26	            padding=0,
27	            dilation=dilation,
28	            bias=bias,
29	        )
30	
31	    def forward(self, x):
32	        # x: (batch, in_channels, seq_len)
33	        x = F.pad(x, (self.pad, 0))
34	        return self.conv(x)
35	        # out: (batch, out_channels, seq_len)
36	
37	
38	class TemporalBlock(nn.Module):
39	    """Residual block with two causal convolutions.
40	
41	    Each block contains two causal conv layers separated by activation
42	    and dropout, followed by a residual skip connection.
43	    """
44	
45	    def __init__(
46	        self,
47	        in_channels,
48	        out_channels,
49	        kernel_size,
50	        dilation,
51	        dropout=0.0,
52	        bias=True,
53	    ):
54	        super().__init__()
55	        self.conv1 = CausalConv1d(
56	            in_channels, out_channels, kernel_size, dilation, bias
57	        )
58	        self.relu1 = nn.ReLU()
59	        self.dropout1 = nn.Dropout(dropout)
