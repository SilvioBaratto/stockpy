16	class DMMModel(PyroModule):
17	    """Deep Markov Model for encoder-decoder time-series forecasting.
18	
19	    The inference network (RNN + Combiner) acts as the encoder,
20	    reading past observations to infer latent states. The generative
21	    network (Transition + Emitter) acts as the decoder, producing
22	    future predictions autoregressively.
23	
24	    Parameters
25	    ----------
26	    n_features : int
27	        Number of input/output features.
28	    pred_len : int
29	        Number of future time steps to predict.
30	    z_dim : int, default=32
31	        Dimensionality of latent states.
32	    emission_dim : int, default=32
33	        Dimensionality of emission parameters.
34	    transition_dim : int, default=32
35	        Dimensionality of transition parameters.
36	    rnn_dim : int, default=32
37	        Dimensionality of RNN hidden states.
38	    num_layers : int, default=1
39	        Number of RNN layers.
40	    dropout : float, default=0.2
41	        Dropout rate (unused, kept for API compatibility).
42	    variance : float, default=0.1
43	        Variance for distributions (unused, kept for API compatibility).
44	    activation : str, default='relu'
45	        Activation function.
46	    bias : bool, default=True
47	        Use bias terms.
48	    context_len : int, default=20
49	        Encoder window length.
50	    """
51	
52	    def __init__(
53	        self,
54	        n_features,
55	        pred_len,
56	        z_dim=32,
57	        emission_dim=32,
58	        transition_dim=32,
59	        rnn_dim=32,
60	        num_layers=1,
61	        dropout=0.2,
62	        variance=0.1,
63	        activation="relu",
64	        bias=True,
65	        context_len=20,
66	    ):
67	        super().__init__()
68	        self.n_features = n_features
69	        self.pred_len = pred_len
70	        self.z_dim = z_dim
71	        self.emission_dim = emission_dim
72	        self.transition_dim = transition_dim
73	        self.rnn_dim = rnn_dim
74	        self.num_layers = num_layers
75	        self.dropout = dropout
76	        self.variance = variance
77	        self.activation = activation
78	        self.bias = bias
79	        self.context_len = context_len
80	
81	        self.emitter = None
82	        self.transition = None
83	        self.combiner = None
84	        self.rnn = None
85	        self.z_0 = None
86	        self.z_q_0 = None
87	        self.h_0 = None
88	
89	    def initialize_module(self, n_features):
90	        """Create sub-modules and initial parameters."""
91	        self.emitter = EmitterRegressor(
92	            n_features, self.z_dim, self.emission_dim, n_features
93	        )
94	        self.transition = Transition(self.z_dim, n_features, self.transition_dim)
95	        self.combiner = Combiner(self.z_dim, self.rnn_dim)
96	        self.rnn = nn.GRU(
97	            input_size=n_features,
98	            hidden_size=self.rnn_dim,
99	            batch_first=True,
100	            bidirectional=True,
101	            num_layers=self.num_layers,
102	            bias=self.bias,
103	        )
104	        self.z_0 = nn.Parameter(torch.zeros(self.z_dim))
105	        self.z_q_0 = nn.Parameter(torch.zeros(1, self.z_dim))
106	        self.h_0 = nn.Parameter(torch.zeros(self.num_layers * 2, 1, self.rnn_dim))
107	
108	    def model(self, x, y, annealing_factor=1.0):
109	        """Generative model over context + future.
110	
111	        Parameters
112	        ----------
113	        x : torch.Tensor, shape (batch, context_len, n_features)
114	            Past observations.
115	        y : torch.Tensor, shape (batch, pred_len, n_features)
116	            Future observations.
117	        annealing_factor : float, default=1.0
118	            KL-divergence annealing factor.
119	        """
120	        full_seq = torch.cat([x, y], dim=1)
121	        T = full_seq.size(1)
122	
123	        pyro.module("dmm", self)
124	        z_prev = self.z_0.expand(x.size(0), self.z_dim)
