29	class _PositionalEncoding(nn.Module):
30	    """Sinusoidal positional encoding for ``(batch, seq, d_model)`` inputs.
31	
32	    The fixed ``pe`` table is registered as a buffer so it follows the module
33	    onto GPU and through ``state_dict`` round-trips without being treated as a
34	    learned parameter.
35	
36	    Parameters
37	    ----------
38	    d_model : int
39	        Embedding dimensionality. Must be even.
40	    max_len : int, default=5000
41	        Maximum sequence length supported.
42	    dropout : float, default=0.1
43	        Dropout applied to the encoded tensor.
44	    """
45	
46	    def __init__(self, d_model: int, max_len: int = 5000, dropout: float = 0.1) -> None:
47	        super().__init__()
48	        self.dropout = nn.Dropout(p=dropout)
49	        self.register_buffer("pe", self._build_table(d_model, max_len))
50	
51	    @staticmethod
52	    def _build_table(d_model: int, max_len: int) -> torch.Tensor:
53	        position = torch.arange(max_len, dtype=torch.float32).unsqueeze(1)
54	        div_term = torch.exp(
55	            torch.arange(0, d_model, 2, dtype=torch.float32)
56	            * (-math.log(10000.0) / d_model)
57	        )
58	        pe = torch.zeros(max_len, d_model)
59	        pe[:, 0::2] = torch.sin(position * div_term)
60	        pe[:, 1::2] = torch.cos(position * div_term)
